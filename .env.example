# ── VoiceTyper Configuration ─────────────────────────────────────────────────

# Required: Your OpenAI API key
OPENAI_API_KEY=sk-your-key-here

# Hotkey to hold for recording (default: right_cmd)
# Options: right_cmd, left_cmd, right_alt, left_alt, right_ctrl, left_ctrl,
#          right_shift, left_shift, caps_lock, f5-f12, or a single character
HOTKEY=right_cmd

# Whisper model (default: whisper-1)
WHISPER_MODEL=whisper-1

# Language code for transcription (default: auto-detect)
# Examples: en, nl, de, fr, es, ja
LANGUAGE=

# Audio sample rate in Hz (default: 16000)
SAMPLE_RATE=16000

# Play beep sounds when recording starts/stops (default: true)
AUDIO_FEEDBACK=true

# Capitalize first letter & add period at end (default: true)
TEXT_CLEANUP=true
