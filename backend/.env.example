# Speakly Cloud Backend - Production Environment Variables
PORT=8787
NODE_ENV=production

# Supabase Auth & Cloud Database (Mandatory)
# Project: https://lwiznvgeemrkrildyyvw.supabase.co
SUPABASE_URL=https://lwiznvgeemrkrildyyvw.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Optional: Supabase Service Role Key (Used only for admin billing webhooks)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# AI Transcription & LLM Engines (Stored on server, never distributed to client apps)
# Primary ultra-fast 0.3s engine: Get key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Fallback STT & LLM engine (Optional)
OPENAI_API_KEY=sk-your_openai_api_key_here

# Billing Webhook HMAC Secret (Optional for Lemon Squeezy / Polar / Stripe webhooks)
BILLING_WEBHOOK_SECRET=your_webhook_signing_secret_here
