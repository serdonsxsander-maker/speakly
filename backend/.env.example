# Speakly Cloud Backend Configuration
PORT=8787

# Supabase Auth & Cloud Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# AI Speech & LLM Provider API Keys (Stored only on server, never distributed to client apps)
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENAI_API_KEY=sk-your_openai_api_key_here

# Client App Integrity Secret (Used to authenticate genuine Speakly desktop clients)
SPEAKLY_CLIENT_SECRET=speakly_beta_secure_client_secret_change_in_production
